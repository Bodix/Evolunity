<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Plugins/uLayout/Editor/UI%20Toolkit/ulayout.uss?fileID=7433441132597879392&amp;guid=4b06b7a5f630e34479f26b83ea4e5859&amp;type=3#ulayout"/>
    <ui:VisualElement style="flex-grow: 0; margin-top: 0; margin-bottom: 3px;">
        <ui:Label text="Label" name="Label" style="margin-left: 3px; margin-bottom: 3px;"/>
        <ui:VisualElement name="Rows" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0.051); padding-top: 3px; padding-bottom: 3px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; margin-left: 4px; margin-right: 4px;">
            <ui:VisualElement name="Top" style="flex-grow: 1; width: 33%; align-self: center;">
                <ui:FloatField label="&lt;&gt;" value="0" name="TopField" tooltip="Top" class="input-field-nolabel"/>
            </ui:VisualElement>
            <ui:VisualElement name="Middle" style="flex-grow: 1; flex-direction: row; justify-content: space-between; margin-top: 3px; margin-bottom: 3px; align-items: center; margin-left: 3px; margin-right: 3px;">
                <ui:FloatField label="&lt;&gt;" value="0" name="LeftField" tooltip="Left" class="input-field-nolabel" style="width: auto; margin-right: 6px; flex-grow: 1; flex-shrink: 1;"/>
                <ui:VisualElement style="flex-grow: 0; margin-left: 0; width: 33%; height: 24px;">
                    <ui:VisualElement name="LineH" style="flex-grow: 0; width: 100%; height: 1px; background-color: rgb(128, 128, 128); position: absolute; top: 50%; bottom: 0; left: 0; right: 0;"/>
                    <ui:VisualElement name="LineV" style="flex-grow: 0; width: 1px; height: 100%; background-color: rgb(128, 128, 128); position: relative; top: 0; bottom: 0; left: 50%; right: 0;"/>
                </ui:VisualElement>
                <ui:FloatField label="&lt;&gt;" value="0" name="RightField" tooltip="Right" class="input-field-nolabel" style="width: auto; margin-left: 6px; flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Bottom" style="flex-grow: 1; width: 33%; align-self: center;">
                <ui:FloatField label="&lt;&gt;" value="0" name="BottomField" tooltip="Bottom" class="input-field-nolabel"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
